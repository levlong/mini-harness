GEMINI_API_KEY=your-key-from-aistudio
# Gemini OpenAI-compatible endpoint
BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# Copy the exact Flash model ID from https://ai.google.dev/gemini-api/docs/models
MODEL=your-flash-model-id
MAX_STEPS=15
# Stop when the same tool call returns the same result this many times
LOOP_LIMIT=3
# Folder the agent is allowed to read/write
WORKSPACE=.
